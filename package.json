{
  "name": "dsh-plugin-image-workbench",
  "version": "1.1.52",
  "type": "module",
  "description": "Bluxe手绘工坊 · 生图工作台（图文 / 摄影）：DSH 侧栏图像生成工作台，默认使用内置本地账号池，亦支持任意 OpenAI 兼容接口（Base URL / API Key / 模型）；可自定义工作台名称与图片存储目录。",
  "icon": "./icon.svg",
  "author": "Bluxe",
  "license": "MIT",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "files": [
    "host.js",
    "icon.svg",
    "client.js",
    "cordis.patch.yml",
    "install.mjs",
    "server/*.py",
    "server/catalog.json",
    "server/changelog.json",
    "server/requirements.txt",
    "server/static",
    "vendor",
    "scripts/vendor-snapshot.py",
    "scripts/fetch-style-images.mjs",
    "scripts/sync-handraw-style.mjs",
    "scripts/style-sync-scheduler.mjs"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guohwa/dsh-plugin-image-workbench.git"
  },
  "homepage": "https://github.com/guohwa/dsh-plugin-image-workbench#readme",
  "bugs": {
    "url": "https://github.com/guohwa/dsh-plugin-image-workbench/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "image-generation",
    "openai-compatible",
    "gpt-image",
    "workbench"
  ]
}
